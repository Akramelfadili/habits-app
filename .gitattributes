# Normalise line endings to LF in the repo and the working tree.
* text=auto eol=lf

# Binary assets: never diff or convert.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.icns binary

# Generated files: collapsed in GitHub diffs.
docs/visual-baseline/** linguist-generated=true
docs/mockups/v3/renders/** linguist-generated=true
package-lock.json linguist-generated=true
