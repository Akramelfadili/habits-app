{
	// Production code under `noUncheckedIndexedAccess` (audit A-02). Run by
	// `make check` and the Stop hook. See docs/how-to/dev-tooling.md
	// § "Strict project". The exclude list below may only shrink.
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"incremental": true,
		"tsBuildInfoFile": "./tsconfig.strict.tsbuildinfo"
	},
	"exclude": [
		"node_modules",
		// Test files: about 350 errors, mostly `result[0]` after an assertion.
		"**/*.test.ts",
		"**/*.test.tsx",
		// Test helpers (jest-only, not shipped).
		"**/test-support/**",
		// PENDING (batch 21, removed group by group): production code not yet fixed.
		"src/modules/habits/services",
		"src/modules/habits/hooks",
		"src/modules/habits/repositories",
		"src/lib",
		"src/components",
		"src/modules/habits/components",
		"src/modules/habits/screens",
		"src/app"
	]
}
