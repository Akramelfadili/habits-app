{
	"name": "habits-app",
	"main": "expo-router/entry",
	"version": "1.0.0",
	"dependencies": {
		"@expo/ui": "~58.0.23",
		"@hookform/resolvers": "^5.9.1",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.3",
		"expo": "~58.0.19",
		"expo-blur": "~58.0.5",
		"expo-clipboard": "~58.0.4",
		"expo-constants": "~58.0.13",
		"expo-device": "~58.0.5",
		"expo-file-system": "~58.0.11",
		"expo-font": "~58.0.10",
		"expo-linking": "~58.0.14",
		"expo-notifications": "~58.1.6",
		"expo-router": "~58.0.26",
		"expo-sharing": "~58.0.20",
		"expo-splash-screen": "~58.0.11",
		"expo-sqlite": "~58.0.14",
		"expo-status-bar": "~58.0.4",
		"expo-symbols": "~58.0.4",
		"expo-system-ui": "~58.0.6",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-hook-form": "^7.88.0",
		"react-native": "0.88.0",
		"react-native-gesture-handler": "~3.3.0",
		"react-native-reanimated": "4.7.1",
		"react-native-safe-area-context": "~5.10.1",
		"react-native-screens": "~4.30.0",
		"react-native-web": "^0.21.4",
		"react-native-worklets": "0.13.0",
		"zod": "^4.6.6",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@testing-library/react-native": "^14.0.1",
		"@types/jest": "30.0.0",
		"@types/node": "^26.6.2",
		"@types/react": "~19.3.0",
		"@types/react-test-renderer": "19.3.0",
		"babel-plugin-inline-import": "^3.0.0",
		"drizzle-kit": "^0.31.11",
		"expo-drizzle-studio-plugin": "^0.2.1",
		"husky": "^9.1.7",
		"jest-expo": "~58.0.12",
		"knip": "^6.40.0",
		"pixelmatch": "^7.2.0",
		"playwright": "^1.63.0",
		"pngjs": "^7.0.0",
		"sf-symbols-typescript": "^2.2.0",
		"sharp": "^0.35.5",
		"typescript": "~6.0.3"
	},
	"scripts": {
		"start": "expo start",
		"android": "expo start --android",
		"ios": "expo start --ios",
		"web": "expo start --web",
		"lint": "biome check .",
		"prepare": "husky",
		"test": "jest",
		"test:perf": "jest --runInBand --testPathIgnorePatterns /node_modules/ /__rsc_tests__/ \"<rootDir>/scripts/\" --testPathPatterns \"\\\\.perf\\\\.test\\\\.tsx?$\"",
		"test:slow": "jest --testPathIgnorePatterns /node_modules/ --testPathPatterns \"\\\\.slow\\\\.test\\\\.tsx?$\"",
		"visual-check": "node scripts/visual-check.mjs",
		"mockups:render": "node scripts/render-mockups.mjs",
		"e2e": "node scripts/e2e.mjs",
		"check-architecture": "node scripts/check-architecture.mjs",
		"check-repo-hygiene": "node scripts/check-repo-hygiene.mjs",
		"check-doc-refs": "node scripts/check-doc-refs.mjs",
		"test:tooling": "node --test \"scripts/**/*.test.mjs\"",
		"ratchet:update": "node scripts/token-ratchet-update.mjs",
		"deadcode": "knip --production",
		"deadcode:all": "knip"
	},
	"private": true,
	"engines": {
		"node": ">=24"
	},
	"jest": {
		"preset": "jest-expo",
		"testTimeout": 15000,
		"maxWorkers": "50%",
		"resolver": "./jest.resolver.js",
		"globalSetup": "./jest.global-setup.js",
		"testEnvironment": "./jest.environment.js",
		"testPathIgnorePatterns": [
			"/node_modules/",
			"/__rsc_tests__/",
			"<rootDir>/scripts/",
			"\\.slow\\.test\\.tsx?$",
			"\\.perf\\.test\\.tsx?$"
		],
		"setupFiles": [
			"./jest.setup.js"
		],
		"setupFilesAfterEnv": [
			"./jest.setup-after-env.js"
		]
	}
}
