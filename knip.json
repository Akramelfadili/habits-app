{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": [
		"src/app/**/*.{ts,tsx}!",
		"scripts/**/*.{js,mjs,cjs}",
		"src/**/*.test.{ts,tsx}",
		"jest.setup.js"
	],
	"project": ["src/**/*.{ts,tsx,js}!", "scripts/**/*.{js,mjs,cjs}"],
	"ignore": ["src/modules/habits/test-support/**"],
	"ignoreDependencies": ["expo-updates"],
	"ignoreBinaries": ["maestro"]
}
